# Optional API keys. Muse subscription mode uses local browser sign-in.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
PORT=3001
HOST=127.0.0.1

# Muse subscription (default): install Muse CLI and sign in with a browser (verified with 1.4.10).
# No API key is needed. Override only when muse is not on PATH.
MUSE_BIN=muse
# Optional paid APIs, only used when explicitly selected in AI Settings.
META_API_KEY=
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
